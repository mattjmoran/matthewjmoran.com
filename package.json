{
	"name": "matthewjmoran.com",
	"version": "1.1.1",
	"description": "A personal website, matthewjmoran.com, built using SvelteKit with Static Site Generation (SSG).",
	"homepage": "https://matthewjmoran.com/",
	"license": "Apache-2.0",
	"author": "Matthew J. Moran <matt@matthewjmoran.com>",
	"private": true,
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/mattjmoran/matthewjmoran.com"
	},
	"engines": {
		"node": "*",
		"pnpm": "*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"cz": "czg",
		"cz-ai": "czg ai -N=5",
		"prepare": "husky"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@eslint/compat": "^1.3.1",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.22.2",
		"@sveltejs/vite-plugin-svelte": "^5.1.0",
		"autoprefixer": "^10.4.21",
		"cssnano": "^7.0.7",
		"czg": "^1.11.2",
		"eslint": "^9.30.1",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-svelte": "^3.10.1",
		"globals": "^16.3.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.1.2",
		"postcss": "^8.5.6",
		"postcss-extend-rule": "^4.0.0",
		"postcss-preset-env": "^10.2.4",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"sanitize.css": "^13.0.0",
		"svelte": "^5.35.1",
		"svelte-check": "^4.2.2",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.35.1",
		"vite": "^6.3.5"
	}
}
