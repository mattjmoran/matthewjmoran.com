{
	"name": "matthewjmoran.com",
	"version": "1.0.0",
	"description": "A personal website, matthewjmoran.com, built using SvelteKit with Static Site Generation (SSG).",
	"homepage": "https://matthewjmoran.com/",
	"license": "Apache-2.0",
	"author": "Matthew J. Moran <matt@matthewjmoran.com>",
	"private": true,
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/mattjmoran/matthewjmoran.com"
	},
	"engines": {
		"node": "*",
		"pnpm": "*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"cz": "czg",
		"cz-ai": "czg ai -N=5",
		"prepare": "husky"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.6.1",
		"@commitlint/config-conventional": "^19.6.0",
		"@eslint/compat": "^1.2.3",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"autoprefixer": "^10.4.20",
		"cssnano": "^7.0.6",
		"czg": "^1.11.0",
		"eslint": "^9.7.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.36.0",
		"globals": "^15.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.3.0",
		"postcss": "^8.4.49",
		"postcss-extend-rule": "^4.0.0",
		"postcss-preset-env": "^10.1.3",
		"prettier": "^3.3.2",
		"prettier-plugin-svelte": "^3.2.6",
		"sanitize.css": "^13.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.0.0",
		"vite": "^5.4.11"
	}
}
