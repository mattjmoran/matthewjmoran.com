%flex-column {
	display: flex;
	flex-flow: column nowrap;
	justify-content: flex-start;
	align-items: stretch;
	align-content: normal;
}

%flex-row {
	display: flex;
	flex-flow: row nowrap;
	justify-content: flex-start;
	align-items: stretch;
	align-content: normal;
}

%flex-center {
	display: flex;
	justify-content: center;
	align-items: center;
}

%no-space {
	margin: 0;
	padding: 0;
}
